      "daf": {
        "daf": "ז",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_13",
      "text": "באר מח' ר\"מ ורבנן ב\"חוששין ללעז\"\\ ב\"חוששין לכבודן של ראשונים\"?",
