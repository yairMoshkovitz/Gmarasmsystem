      "daf": {
        "daf": "מג",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_85",
      "text": "מה החידוש בדיני עדות שלמדו ממעשה דבעיא מיכסא (שמעון בן שטח והמכשפות)?",
