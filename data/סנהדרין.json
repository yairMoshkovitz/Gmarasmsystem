      "daf": {
        "daf": "יד",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_26",
      "text": "מהו \"המקום\" לעניין מעשר שני ולעניין מעשר שני ולעניין סנהדרי הגדולה? (תוס')",
