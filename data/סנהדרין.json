{
  "title": "שאלות סנהדרין",
  "questions": [
    {
      "id": "סנהדרין_1",
      "text": "כמה דיינים בסנהדרין גדולה ומניין, כמה בקטנה ומניין?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ב",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_2",
      "text": "מדוע לא לומדים מומחים בממונות מנפשות? (תוס')",
      "question_type": "תוס'",
      "daf": {
        "daf": "ב",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_3",
      "text": "למסקנה מה פירוש \"דיני ממונות בשלושה\" ומה דינם מדאורייתא ומדרבנן?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ג",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_4",
      "text": "מה דין גזילות וחבלות לעניין מומחין ולעניין דרישה וחקירה? (גמ' ותוס')",
      "question_type": "תוס'",
      "daf": {
        "daf": "ג",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_5",
      "text": "מה ב' האופנים בהסבר מחלוקת ר\"ש ורבנן בדפנות סוכה?",
