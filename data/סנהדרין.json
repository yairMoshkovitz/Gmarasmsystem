      "daf": {
        "daf": "לז",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_72",
      "text": "איזה דין מותר בנידה ואסור באשת איש, ואיזה דין אסור בשתיהן?",
      "question_type": "תוס'",
      "daf": {
        "daf": "לז",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_73",
      "text": "מדוע נברא אדם יחידי? (לפחות ג' טעמים)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לח",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_74",
      "text": "מה הפירוש \"המתיישב ביינו\"? (תוס')",
