      "daf": {
        "daf": "מד",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_87",
      "text": "מדוע בסקילה חששו רבנן להרהור לכאורה, ובסוטה לא חששו, ור' יהודה להפך?!",
