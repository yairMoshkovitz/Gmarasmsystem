      "daf": {
        "daf": "ה",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_8",
      "text": "באיזה מרחק מותר להורות בפני רבו ומניין? (גמ'), ומתי אסור אפילו רחוק? (תוס')",
      "question_type": "תוס'",
      "daf": {
        "daf": "ה",
        "amud": null
      }
    },
    {
      "id": "סנהדרין_9",
      "text": "היכי דמי טעה \"בשיקול הדעת\" ומה הדין בזה?",
