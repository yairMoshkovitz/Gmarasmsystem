      "daf": {
        "daf": "מב",
        "amud": null
      }
    },
    {
      "id": "קידושין_83",
      "text": "באיזה דברים גם לשמאי הזקן אין שליחות לדבר עבירה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מג",
        "amud": null
      }
    },
    {
      "id": "קידושין_84",
      "text": "האם במעילה שע\"י הנאה יש שליחות לדבר עבירה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מג",
        "amud": null
      }
    },
    {
      "id": "קידושין_85",
      "text": "האם נערה יכולה לקדש את עצמה או שהיא מתקדשת רק ע\"י אביה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מד",
        "amud": null
      }
    },
    {
      "id": "קידושין_86",
      "text": "האם קטנה שיש לה אב יכולה לקבל את גיטה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מד",
        "amud": null
      }
    },
    {
      "id": "קידושין_87",
      "text": "קטנה שנישאת שלא מדעת אביה למה לא אוכלת בתרומה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מה",
        "amud": null
      }
    },
    {
      "id": "קידושין_88",
      "text": "למה לא מספיק מה שאין את החששות שבגללם ארוסה לא אוכלת בתרומה, וא\"כ ממה נפשך תאכל תרומה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מה",
        "amud": null
      }
    },
    {
      "id": "קידושין_89",
      "text": "מה הדין במקדש אחותו, ולמה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מו",
        "amud": null
      }
    },
    {
      "id": "קידושין_90",
      "text": "מה הדין במקום שאדם נותן קידושין למישהי ולא יודע בודאי שהקידושין לא יחולו? (בשונה מאחותו שהוא יודע)",
      "question_type": "תוס'",
      "daf": {
        "daf": "מו",
        "amud": null
      }
    },
    {
      "id": "קידושין_91",
      "text": "למה המקדש במלוה אינה מקודשת?",
