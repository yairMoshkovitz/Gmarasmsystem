      "daf": {
        "daf": "נט",
        "amud": null
      }
    },
    {
      "id": "קידושין_116",
      "text": "מתי עני המהפך בחררה הוי רשע לדעת רש\"י ולדעת ר\"ת?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נט",
        "amud": null
      }
    },
    {
      "id": "קידושין_117",
      "text": "מקדש לאחר שלושים יום ובא אחר וקידשה בתוך הזמן מה הדין?",
