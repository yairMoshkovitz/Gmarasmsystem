      "daf": {
        "daf": "נד",
        "amud": null
      }
    },
    {
      "id": "קידושין_107",
      "text": "למה אין מועל אחר מועל אלא בבהמה ובכלי שרת?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נה",
        "amud": null
      }
    },
    {
      "id": "קידושין_108",
      "text": "באיזה ציור מדובר שאין מועל אחר מועל, ומתי יש מועל אחר מועל בכל הקדש?",
