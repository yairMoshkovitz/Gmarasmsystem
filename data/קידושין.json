      "daf": {
        "daf": "נ",
        "amud": null
      }
    },
    {
      "id": "קידושין_98",
      "text": "לדעת תוספות מה החשש בסבלונות?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נ",
        "amud": null
      }
    },
    {
      "id": "קידושין_99",
      "text": "מה הציור של קידושין שאינם מסורים לביאה?",
