      "daf": {
        "daf": "נב",
        "amud": null
      }
    },
    {
      "id": "קידושין_103",
      "text": "המקדש בחלקו אינה מקודשת, איך זה מסתדר עם ריה\"ג שקדשים קלים הם ממונו?",
