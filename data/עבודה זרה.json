      "daf": {
        "daf": "לג",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_22",
      "text": "התנה תנאי בגט שתלוי ביציאת החמה מנרתיקה, מתי חל הגט?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לז",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_23",
      "text": "שתיתאה בבישול עכו\"ם, איזה מותר באכילה, ואיזה אסור?",
