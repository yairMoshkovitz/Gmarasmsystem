      "daf": {
        "daf": "נב",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_32",
      "text": "הלוקח עבדים מן העכו\"ם, מה דינו לענין טומאה, ולענין יין נסך?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נז",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_33",
      "text": "עכו\"ם שנשא נוד, באיזה אופן נעשה יין נסך, ובאיזה לא נעשה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ס",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_34",
      "text": "שכר ביתו בחצירו של עכו\"ם ומילאהו ביין ישראל, האם הוי יי\"נ?",
