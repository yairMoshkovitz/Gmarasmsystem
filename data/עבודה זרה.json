{
  "title": "שאלות עבודה זרה",
  "questions": [
    {
      "id": "עבודה זרה_1",
      "text": "מה אסור לפני אידיהן של עכו\"ם?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ב",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_2",
      "text": "מי מעיד על בני ישראל שקיימו את התורה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ג",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_3",
      "text": "המוכר בהמה לחבירו האם צריך להודיעו אמה מכרתי לשחוט, ומתי, ומה הטעם?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ה",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_4",
      "text": "דברים האסורים באידיהם, כמה ימים הם האסורים?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ז",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_5",
      "text": "עכו\"ם שהזמין אנשים לסעוד אצלו, מתי מותר ליהודי לאכול, ומתי אסור?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ח",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_6",
      "text": "עיר שיש בה ע\"ז האם מותר לקנות שם ביריד וכדו'?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "יב",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_7",
      "text": "אם החרים סתם בזה\"ז, מה דינם?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "יג",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_8",
      "text": "איזה תרנגולת מוכרים לעכו\"ם, ואיזה אין מוכרים, ובאיזה אופן?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "יד",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_9",
      "text": "איזה בהמה וחיה אסור למכור לעכו\"ם ואיזה מותר?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "טז",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_10",
      "text": "האם מותר לילך לטרטיאות, ומה הטעם, ומה הנפק\"מ בין הטעמים?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "יח",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_11",
      "text": "באיזה אופן מותר להורות הוראה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "יט",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_12",
      "text": "מה לומדים מהפסוק \"לא תחנם\"?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "כ",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_13",
      "text": "האם מוכרין או משכירין בתים או שדות לעכו\"ם, ומה הטעם?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "כא",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_14",
      "text": "מה הן הדברים הפסולים בפרה אדומה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "כג",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_15",
      "text": "האם מותר ליקח מעכו\"ם בהמה לקרבן, ומה הטעם?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "כד",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_16",
      "text": "באיזה אופן מותר לאשה להתייחד עם איש, ובאיזה אסור?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "כה",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_17",
      "text": "האם בת ישראל מותרת ליילד את העכו\"ם, וכן להיפך, והטעם?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "כו",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_18",
      "text": "באיזה אופן מתרפאין מהעכו\"ם, ובאיזה אופן אין מתרפאין?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "כז",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_19",
      "text": "דברים שאסורים לקחת מגוי האם מהני לשלוח בתוך חותם, ובכמה חותמות?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לא",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_20",
      "text": "הולכין לתרפות והחוזרין, האם מותר לשאת ולתת עמהם?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לב",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_21",
      "text": "כלי חרס מצופה באבר של יין עכו\"ם או של חמץ, האם מותרים?",
