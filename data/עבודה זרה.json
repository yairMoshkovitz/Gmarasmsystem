      "daf": {
        "daf": "סב",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_36",
      "text": "איזה אתנן מותר בהקרבה, ואיזה אתנן אסור בהקרבה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סג",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_37",
      "text": "עכו\"ם ששילם ליהודי חובו מדמי ע\"ז, האם מותר לישראל לקבל התשלום?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סד",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_38",
      "text": "השוכר את החמור, האם השוכר או החמר מניח על החמור מזונות, וכמה?",
