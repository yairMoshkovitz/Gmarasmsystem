      "daf": {
        "daf": "מז",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_27",
      "text": "האם מותר לישב בצל אשירה או לעבור תחתיה, ומה הדין אם עבר או ישב?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מח",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_28",
      "text": "האיך מבטלין אשירה, ומה הדין אשירה שנשברה לענין ביטול, ומה הטעם?",
