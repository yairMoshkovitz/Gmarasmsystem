      "daf": {
        "daf": "סח",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_41",
      "text": "הניח את העכו\"ם בחנות שיש חביות יין, האם נאסר היין?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סט",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_42",
      "text": "בית שיש בו יין ישראל ונכנס עכו\"ם נסגר הדלת ויש חור בדלת, וראה העכו\"ם בין החביות באיזה אופן נאסר היין, ובאיזה אופןלא נאסר?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ע",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_43",
      "text": "יין נסך האם מתבטל, ובכמה, ובאיזה אופן?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עג",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_44",
      "text": "גת שזפתה עכו\"ם האיך מטהרה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עד",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_45",
      "text": "איזה כלים חדשים צריכין טבילה, ובאיזה אופן?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עה",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_46",
