      "daf": {
        "daf": "נ",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_30",
      "text": "עבודה זרה שהיה לה גינה או מרחץ, האם נהנין ממנה, ובאיזה אופן?",
