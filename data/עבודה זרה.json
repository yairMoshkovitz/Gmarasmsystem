      "daf": {
        "daf": "לח",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_24",
      "text": "המוצא שברי צלמים או שברי ע\"ז, האם מותרין?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מא",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_25",
      "text": "האיך יכלו להניח על ראש דוד המלך את עטרת מלכם שמשקלה ככר זהב?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מד",
        "amud": null
      }
    },
    {
      "id": "עבודה זרה_26",
      "text": "מי שהיה כותלו אחד מכותלי בית ע\"ז, ונפל, כיצד יעשה?",
