      "daf": {
        "daf": "צח",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_194",
      "text": "מדוע עבד יוצא לחרות בחרשו הרי אינו בגלוי? (ב' תירוצים)",
      "question_type": "תוס'",
      "daf": {
        "daf": "צח",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_195",
      "text": "באר ב' נפקא מינות האם אומן קונה או לא קונה בשבח כלי?",
