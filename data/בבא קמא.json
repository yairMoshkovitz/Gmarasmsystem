      "daf": {
        "daf": "קא",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_200",
      "text": "למה צריך ריבוי מיוחד ל\"לא יצבע בו\" ו\"לא ידליק בו את הנר\"?",
