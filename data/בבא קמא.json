    },
    {
      "id": "בבא קמא_66",
      "text": "מדוע הקשתה הגמרא דמצינו לר' יהודה תם חמור ממועד, הרי צד תמות במקומה עומדת?",
      "question_type": "תוס'",
      "daf": {
        "daf": "לד",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_67",
      "text": "מה דין טענו חיטים והודה לו בשעורים? האם מהמשנה יש ראיה לחייב ? כיצד בבריתא מחייבים דמי שור קטן",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לה",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_68",
      "text": "למה איצטריך כל הבבות במשנה? (בסלע לקה, קטן וגדול, תם ומועד, ניזקים שנים)",
      "question_type": "תוס'",
      "daf": {
        "daf": "לה",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_69",
      "text": "\"אחרון אחרון נשכר\", למה לא ראשון?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לו",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_70",
      "text": "מה הדין בתפסו ניזק לפי ר' עקיבא? (רש\"י\\ תוס')",
      "question_type": "תוס'",
      "daf": {
        "daf": "לו",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_71",
      "text": "מה הנפקא מינה אם גורסים במשנה \"אינו מועד\" או \"ואינו מועד\", וכמי הוכיחו לגרוס? כיצד?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לז",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_72",
      "text": "\"שור נגח, חמור לא נגח, סוס נגח וכו' \"- מועד לסירוגין לכל, הרי לרב זביד אפ' בשוורים לבד? (2 תירוצים)",
      "question_type": "תוס'",
      "daf": {
        "daf": "לז",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_73",
      "text": "מה 2 האפשרויות לדרוש בפסוק \"ראה ויתר גויים\"?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לח",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_74",
      "text": "כיצד לימדו תורה לסרדיוטות, הרי עובר בעשה של \"מגיד דבריו ליעקב\"?",
      "question_type": "תוס'",
      "daf": {
        "daf": "לח",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_75",
      "text": "מה דין שור תם של יתומים, ומה דין שור מועד?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לט",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_76",
      "text": "מדוע בתחילה הקשו דבשור תם פשיטא, ואח\"כ הקשו \"לוקמה בשור\"?",
      "question_type": "תוס'",
      "daf": {
        "daf": "לט",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_77",
      "text": "\"הועד בבית שואל והחזירו- בעלים משלמים חצי נזק ושואל פטור\"- סיפא רשות משנה ורישא אינה משנה!? (ג' תירוצים)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מ",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_78",
      "text": "כיצד טוען \"הוה מעריקנא לאגמא\" הרי זה שלא כדין?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מ",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_79",
      "text": "ר' אליעזר \"נקי\" מחצי כופר, והרי משתלם מגופו והביאו לבי\"ד וישלם לך?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מא",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_80",
      "text": "מה הטעם שר' אליעזר ור' עקיבא לא מפרשים את המיעוט \"נקי\" לעניין דמים?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מא",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_81",
      "text": "כיצד מצינו לר' עקיבא דבעל אין יורש כופר ואין יורש נזיקין של אשתו?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מב",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_82",
      "text": "מדוע נקט נזק וצער לאישה ולא נקט ריפוי שבת ובושת?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מב",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_83",
      "text": "מה הן צדדדי הספק ב\"אישו שלא בכוונה\"?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מג",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_84",
      "text": "מדוע לא נקט אישו בכוונה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מג",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_85",
      "text": "מה דין שור שהזיק של בכוונה, ומה הטעם? (מחלוקת ר' יהודה ור' שמעון).",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מד",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_86",
      "text": "כיצד לומדים דין קבוע ע\"פ חכמים וכיצד ע\"פ ר' שמעון?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מד",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_87",
      "text": "איזו שמירה לשור תם ואיזו שמירה לשור מועד?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מה",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_88",
      "text": "מה שני האופנים לפרש \"בחזקת שימור\"?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מה",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_89",
      "text": "כיצד פירשו \"חצי נזק מהפרה ורביע נזק מהוולד\" על פי אביי ועל פי רבא?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מו",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_90",
      "text": "מ\"מידע ידעי דשותפות אית לי\"- מדוע מודה סומכוס  שלא יוציאו מהמוחזק?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מו",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_91",
      "text": "במה נחלקו  רבי וחכמים  במכניס לחצר בעל הבית  על פי ר' זירא ועל פי רבא?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מז",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_92",
      "text": "איך ניתן לפטור במכניס שורו  ברשות , הרי קרן בחצר  שותפין חייב?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מז",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_93",
      "text": "נפל שור לבור והרג- חייב כופר , מדוע? הרי  תם הוא? (ג' תירוצים)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מח",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_94",
      "text": "מה הצדדים בספק כמי לפסוק בהכניס שורו כרבי או כרבנן?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מח",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_95",
      "text": "במה נחלקו רשב\"ג וחכמים  בתשלום שור שנגח אישה ויצאו ילדיה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מט",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_96",
      "text": "האם זכות הבעל בוולדות עוברת ליורשים? (גמרא, תוס')",
      "question_type": "תוס'",
      "daf": {
        "daf": "מט",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_97",
      "text": "איזה בור  \"זהו בור האמור בתורה\"?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נ",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_98",
      "text": "מה טעם הפטור בבור ברשותו? (למאן דאמר פטור)",
      "question_type": "תוס'",
      "daf": {
        "daf": "נ",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_99",
      "text": "\"עבר עליו הראשון ולא כסהו והשני ולא כסהו- השני חייב\". מאמיתי נפטר הראשון? פרט!",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נא",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_100",
      "text": "האם דריסת רגל מותרת למודר הנאה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נא",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_101",
      "text": "מה  הדין בכיסוי  שיכול לעמוד בשוורים , ולא עומד בגמלים,  וגמלים ארעדה, ונפלו שוורים?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נב",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_102",
      "text": "לר' יוחנן \"בכדי שיודיעוהו  וישכור פועלים וכו'\", האם גם לשני נותנים שיעור זה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נב",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_103",
      "text": "מה דין שור ושור פסולי המוקדשים שנגחו יחד?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נג",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_104",
      "text": "האם הסוגיא כמ\"ד  \"כוליה נזקא\" או כמ\"ד \"פלגא נזקא\"? נמק.",
      "question_type": "תוס'",
      "daf": {
        "daf": "נג",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_105",
      "text": "למסקנה, מנא לן דין שביתת בהמתו בכל בעל חיים?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נד",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_106",
      "text": "לפי מה שרצו ללמוד כלל ופרט וכלל  מדוע  לא נחשב מורחקים  זה מזה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נד",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_107",
      "text": "מה הן ארבע דברים שהתורה  מעטה  בשמירתן, ומה ארבע דברים שפטור בדיני אדם וחייב בדיני שמים?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נה",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_108",
      "text": "מה הן שני הדרכים ב\"נפרצה בלילה פטור\"? (2 דרכים בתוס')",
      "question_type": "תוס'",
      "daf": {
        "daf": "נה",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_109",
      "text": "באר מחלוקת רבה ובר יוסף בדין שומר אבידה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נו",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_110",
      "text": "באיזה מאן דאמר פסקו הראשונים (ר' חננאל והלכות גדולות)? הבא ראיה לאחד הצדדים",
      "question_type": "תוס'",
      "daf": {
        "daf": "נו",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_111",
      "text": "שוכר פרה ונגנבה ואומר הריני משלם וכו', נמצא הגנב משלם כפל וכו', האם זה מוכיח שליסטים מזויין גנב? (ב' דחיות בגמרא)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נז",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_112",
      "text": "למ\"ד כפילא בשבועה עדיף מקרנא בלא שבועה - מנא לן דפרשה ראשונה בשומר חינם ושניה בשומר חינם?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נז",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_113",
      "text": "כיצד שמין אגב שדה? (ג' דעות בגמרא)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נח",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_114",
      "text": "באר את עיקר מחלוקת רש\"י תוספות בדין זה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נח",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_115",
      "text": "באיזה מקרה דן רב כר\"מ ואיזה פסק הלכה כר\"ש?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נט",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_116",
      "text": "מדוע \"מסאני אוכמי\" מראה שהיה אבל על ירושלים, הרי כולם הלכו עם מנעל שחור?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נט",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_117",
      "text": "\"ליבה וליבתו הרוח ואין בליבויו כדי ללבותה- פטור\", מדוע? ליהוי כ\"זורה ורוח מסייעתו\"? (ד' תירוצים)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ס",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_118",
      "text": "האם מדובר בברייתא באופן שהרוח היתה יכולהבפני עצמה ללבות? נמק.",
      "question_type": "תוס'",
      "daf": {
        "daf": "ס",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_119",
      "text": "מאי \"שלולית\" (לעניין מפסיק לפאה)? ב' פירושים,  מה סבירא ליה לכל פירוש על הפירוש האחר?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סא",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_120",
      "text": "מה חידוש המשנה שם בדין דרך רבים, דרך יחיד, שביל רבים, שביל יחיד?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סא",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_121",
      "text": "מה דין הנותן דינר זהה לאישה ואמר לה של כסף הוא (ומה הטעם)?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סב",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_122",
      "text": "האם עשו תקנת נגזל במסור? (גמרא ותוס')",
      "question_type": "תוס'",
      "daf": {
        "daf": "סב",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_123",
      "text": "\"על כל דבר פשע\", 'כל'- ריבויא , ורהי במעשר \"בכל אשר\"- זה רק \"כללא\"? (ב' תירוצים)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סג",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_124",
      "text": "\"רעהו\" למיעוט הקדש, והרי לקמן מיעט \"הקדש\" מאיש?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סג",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_125",
      "text": "למאן דאמר חד בגנב  וחד בטוען טענת גנב - למאי איצטריך \"המצא תמצא\"?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סד",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_126",
      "text": "איזה פסוק נוסף לימד מה שלמדו מ\"המצא תמצא\" ואם כן מאי קמ\"ל פסוק נוסף? (גמרא בלבד)",
      "question_type": "תוס'",
      "daf": {
        "daf": "סד",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_127",
      "text": "\"חומשו עולה לו בכפלו\", היכי דמי לפי המקשן (המסייע לרב) , ואיך לפי התירוץ?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סה",
        "amud": null
      }
    },
    {
      "id": "בבא קמא_128",
      "text": "מדוע לא להעמיד דמעיקרא זוזא והשתא ד'? (ואז זה הפוך מדעת רב)",
