      "daf": {
        "daf": "כא",
        "amud": null
      }
    },
    {
      "id": "מכות_41",
      "text": "מהיכן למד רבא כמה טיפשי אנשי דקמו מקמי ס\"ת ולא מקמי ת\"ח?",
