      "daf": {
        "daf": "מה",
        "amud": null
      }
    },
    {
      "id": "נזיר_36",
      "text": "כהן משוח מלחמה וסגן- איזה מהם עדיף?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מז",
        "amud": null
      }
    },
    {
      "id": "נזיר_37",
      "text": "על המת ועל כזית מן - על כזית מגלח על מת עצמו לא כל שכן?",
