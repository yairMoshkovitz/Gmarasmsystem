      "daf": {
        "daf": "סה",
        "amud": null
      }
    },
    {
      "id": "נזיר_52",
      "text": "מצא ג' קברות, א' ידוע וב' בתחילה האם יש כאן שכונת קברות?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סה",
        "amud": null
      }
    }
