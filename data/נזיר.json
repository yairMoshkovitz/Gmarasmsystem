      "daf": {
        "daf": "נ",
        "amud": null
      }
    },
    {
      "id": "נזיר_39",
      "text": "כזית מת שהיה מפורד לחתיכות והתיכו האם מטמא במגע ובאהל?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נ",
        "amud": null
      }
    },
    {
      "id": "נזיר_40",
      "text": "רקב הבא מב' מתים מטמא ומגלח או הוי גלגלין?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נא",
        "amud": null
      }
    },
    {
      "id": "נזיר_41",
      "text": "מה דין \"אבן הסכוכית\"?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נג",
        "amud": null
      }
    },
    {
      "id": "נזיר_42",
      "text": "האם כהן ונזיר מוזהרין על דין \"חרב הרי היא כחלל\"?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נד",
        "amud": null
      }
    },
    {
      "id": "נזיר_43",
      "text": "הנכנס לארץ העמים בשידה תיבה ומגדל ,למסקנא במאי פליגי רבי וריבר\"י?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נה",
        "amud": null
      }
    },
    {
      "id": "נזיר_44",
      "text": "נזיר שיש לו נגע צרעת האם עולין ימי הצרעת לימי הנזירות?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נו",
        "amud": null
      }
    },
    {
      "id": "נזיר_45",
      "text": "נזרקה טומאה בין שני אנשים ברה\"ר וספק מי מהם נטמא - מה הדין?",
