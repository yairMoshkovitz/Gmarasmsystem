      "daf": {
        "daf": "ד",
        "amud": null
      }
    },
    {
      "id": "כתובות_7",
      "text": "מה ב' הסיבות שאלמנה נישאת ביום חמישי?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ה",
        "amud": null
      }
    },
    {
      "id": "כתובות_8",
      "text": "לתוספות מה הנפק\"מ הפשוטה בין הטעמים, שלא נזכרה בגמרא?",
