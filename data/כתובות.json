      "daf": {
        "daf": "ח",
        "amud": null
      }
    },
    {
      "id": "כתובות_14",
      "text": "האם ברכה הסמוכה לברכה קצרה נחשבת ברכה הסמוכה לחברתה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "ח",
        "amud": null
      }
    },
    {
      "id": "כתובות_15",
      "text": "למה אשה נאסרת בטענת פתח פתוח הרי אין עדים ואין קינוי וסתירה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ט",
        "amud": null
      }
    },
    {
      "id": "כתובות_16",
      "text": "איזה ספק ספיקא יש באשת ישראל שאביה קבל קידושין בפחות מג' שנים, ולמה אין לו דין של ספק ספיקא?",
      "question_type": "תוס'",
      "daf": {
        "daf": "ט",
        "amud": null
      }
    },
    {
      "id": "כתובות_17",
      "text": "האם בחור נאמן לטעון פתח פתוח מצאתי?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "י",
        "amud": null
      }
    },
    {
      "id": "כתובות_18",
      "text": "האם כתובה דאוריתא או דרבנן? (כתוב מה הדין לפי הסוגיא שלנו ומה דעת התוספות)",
      "question_type": "תוס'",
      "daf": {
        "daf": "י",
        "amud": null
      }
    },
    {
      "id": "כתובות_19",
      "text": "למי נחשב זכות להיות יהודי ולמי זה חוב?",
