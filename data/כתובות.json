      "daf": {
        "daf": "לב",
        "amud": null
      }
    },
    {
      "id": "כתובות_63",
      "text": "למה עדים זוממים משלמים ולא לוקים?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לג",
        "amud": null
      }
    },
    {
      "id": "כתובות_64",
      "text": "האם מי שנפטר בקים ליה בדרבה מיניה צריך לצאת ידי שמים?",
      "question_type": "תוס'",
      "daf": {
        "daf": "לג",
        "amud": null
      }
    },
    {
      "id": "כתובות_65",
      "text": "באיזה ציור יש חיוב ארבעה וחמישה בשור הנסקל, הרי הוא איסורי הנאה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לד",
        "amud": null
      }
    },
    {
      "id": "כתובות_66",
      "text": "מה ההבדל בין דינא דגרמי לבין דבר הגורם לממון?",
      "question_type": "תוס'",
      "daf": {
        "daf": "לד",
        "amud": null
      }
    },
    {
      "id": "כתובות_67",
      "text": "מה הדין בחייבי מיתות שוגגין וממון באותו מעשה? ומה הדין בחייבי מלקות שוגגין וממון?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לה",
        "amud": null
      }
    },
    {
      "id": "כתובות_68",
      "text": "אם לא יהיה אסון ענוש יענש- באיזה מצב לתנא דבי חזקיה חייבים ממון? מה הכוונה לא יהיה אסון?",
      "question_type": "תוס'",
      "daf": {
        "daf": "לה",
        "amud": null
      }
    },
    {
      "id": "כתובות_69",
      "text": "למה לחרשת אין טענת בתולים לדעת רש\"י?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לו",
        "amud": null
      }
    },
    {
      "id": "כתובות_70",
      "text": "למה לחרשת אין טענת בתולים לדעת תוספות?",
      "question_type": "תוס'",
      "daf": {
        "daf": "לו",
        "amud": null
      }
    },
    {
      "id": "כתובות_71",
      "text": "מה הצריכותא בין דין מלקות וממון לדין מיתה וממון?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לז",
        "amud": null
      }
    },
    {
      "id": "כתובות_72",
      "text": "האם התירוץ שאשה מזנה מתהפכת ומזנה מועיל לשפחה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "לז",
        "amud": null
      }
    },
    {
      "id": "כתובות_73",
      "text": "למי הולך הקנס של נערה שמתה אם יש בגר בקבר?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לח",
        "amud": null
      }
    },
    {
      "id": "כתובות_74",
      "text": "האם אדם מוריש קנס לבניו? אם לא מה הנפק\"מ של בגר בקבר?",
      "question_type": "תוס'",
      "daf": {
        "daf": "לח",
        "amud": null
      }
    },
    {
      "id": "כתובות_75",
      "text": "באיזה מקרה נחלקו ר\"ש ורבנן לגבי חיוב צער? מה הצד לפטור?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "לט",
        "amud": null
      }
    },
    {
      "id": "כתובות_76",
      "text": "למה הש\"ס לא תירץ שמדובר בצער שיש לבתולה בביאה ראשונה? כתוב לפחות תשובה אחת.",
      "question_type": "תוס'",
      "daf": {
        "daf": "לט",
        "amud": null
      }
    },
    {
      "id": "כתובות_77",
      "text": "למה ר\"א פוטר מפתה יתומה שנתארסה ונתגרשה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מ",
        "amud": null
      }
    },
    {
      "id": "כתובות_78",
      "text": "למה אין עשה דוחה לא תעשה באונס אשה שאסורה עליו? כתוב ב' הסברים מרש\"י ותוספות.",
      "question_type": "תוס'",
      "daf": {
        "daf": "מ",
        "amud": null
      }
    },
    {
      "id": "כתובות_79",
      "text": "האם אדם נאמן לחייב עצמו בבושת ופגם? מה הצד שהוא לא יכול?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מא",
        "amud": null
      }
    },
    {
      "id": "כתובות_80",
      "text": "מה הדין בקנסות בבבל? איזה דברים מועיל לתפוס?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מא",
        "amud": null
      }
    },
    {
      "id": "כתובות_81",
      "text": "למה לרבנן אונס שכופר חייב קרבן שבועה גם לפני עמידה בדין?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מב",
        "amud": null
      }
    },
    {
      "id": "כתובות_82",
      "text": "האם הסוגיא דנה רק בהלכות קרבן שבועה, או שהספק של הגמרא הוא גם לגבי אם הוי קנס או ממון?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מב",
        "amud": null
      }
    },
    {
      "id": "כתובות_83",
      "text": "בת הניזונת מן האחין מעשה ידיה למי למסקנת הגמרא?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מג",
        "amud": null
      }
    },
    {
      "id": "כתובות_84",
      "text": "מה הדין במקום שפצעו את הבת באופן שהיא שווה פחות- כמה משלמים לאב?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מג",
        "amud": null
      }
    },
    {
      "id": "כתובות_85",
      "text": "מה הדין מוציא שם רע על היתומה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מד",
        "amud": null
      }
    },
    {
      "id": "כתובות_86",
      "text": "האם דין הוצאת שם רע תלוי בתשלום קנס?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מד",
        "amud": null
      }
    },
    {
      "id": "כתובות_87",
      "text": "באיזה מקרה של נערה שזינתה יש נפק\"מ שאשתני דינא אשתני קטלא, ובאיזה מיתה היא תמות?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מה",
        "amud": null
      }
    },
    {
      "id": "כתובות_88",
      "text": "לשיטה השניה בתוספות (רבנו שמואל) באיזה מקרה יש לנערה מיתה חמורה יותר במוציא שם רע מאשר אם באו עדים בלי הוצאת שם רע?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מה",
        "amud": null
      }
    },
    {
      "id": "כתובות_89",
      "text": "לשיטת ראב\"י מתי הבעל יכול להוציא שם רע על אשתו, ולמה הוא מסתדר יותר בפסוק?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מו",
        "amud": null
      }
    },
    {
      "id": "כתובות_90",
      "text": "מה כוונת הפוסק ופרשו השמלה, הרי אין משמעות אמיתית לשמלה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מו",
        "amud": null
      }
    },
    {
      "id": "כתובות_91",
      "text": "למה פשוט שמעשי ידי הקטנה הולכים לאב גם בלי פסוק?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מז",
        "amud": null
      }
    },
    {
      "id": "כתובות_92",
      "text": "האם למ\"ד שמעשיה ידיה עיקר הבעל יכול לומר צאי מעשה ידיך במזונותיך? (למסקנת התוספות)",
      "question_type": "תוס'",
      "daf": {
        "daf": "מז",
        "amud": null
      }
    },
    {
      "id": "כתובות_93",
      "text": "למה לא גובים מזונות הבנים ממי שהלך למדה\"י וכן גובים ממי שהשתטה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מח",
        "amud": null
      }
    },
    {
      "id": "כתובות_94",
      "text": "באיזה מצב גובים מזונות הבנים ממי שהלך למדה\"י? האם זה גם במקום שהוא לא היה נותן קודם (למסקנת התוספות)",
      "question_type": "תוס'",
      "daf": {
        "daf": "מח",
        "amud": null
      }
    },
    {
      "id": "כתובות_95",
      "text": "האם אב חייב במזונות בתו? מה הדין לפי המשנה ומה הדין לתקנת אושא?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "מט",
        "amud": null
      }
    },
    {
      "id": "כתובות_96",
      "text": "האם יש חילוק בנשואה שהתאלמנה בין מקום שהיא נבעלה למקום שלא נבעלה לגבי השאלה אם היא חוזרת לרשות האב?",
      "question_type": "תוס'",
      "daf": {
        "daf": "מט",
        "amud": null
      }
    },
    {
      "id": "כתובות_97",
      "text": "לענין מה תקנו שאסור לבזבז יותר מחומש?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נ",
        "amud": null
      }
    },
    {
      "id": "כתובות_98",
      "text": "האם למ\"ד קנין פירות כקנין הגוף יש את תקנת אושא שהאשה לא יכולה למכור?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נ",
        "amud": null
      }
    },
    {
      "id": "כתובות_99",
      "text": "למה מי שלא כתב כתובה חייב לשלם אע\"פ שלא כתב? האם זה לכו\"ע? (למסקנת הגמרא)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נא",
        "amud": null
      }
    },
    {
      "id": "כתובות_100",
      "text": "מתי לר\"מ יש איסור של בעילת זנות כי אין כתובה, ומתי ר\"מ סובר שחייבים כתובה אע\"פ שלא אמורה להיות? (כתוב או את שיטת ר\"י או את שיטת ריב\"ן)",
      "question_type": "תוס'",
      "daf": {
        "daf": "נא",
        "amud": null
      }
    },
    {
      "id": "כתובות_101",
      "text": "מה הדין כהנת שנשבתה האם הבעל חייב לפדותה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נב",
        "amud": null
      }
    },
    {
      "id": "כתובות_102",
      "text": "פעם ראשונה פודה שניה אינו פודה- למה לא חייב לפדות בפעם השניה לרשב\"ג? (רש\"י ותוספות)",
      "question_type": "תוס'",
      "daf": {
        "daf": "נב",
        "amud": null
      }
    },
    {
      "id": "כתובות_103",
      "text": "מוכרת כתובתה לאחרים או לבעלה יש לה כתובת בנין דכרין?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נג",
        "amud": null
      }
    },
    {
      "id": "כתובות_104",
      "text": "האם הסוגיא של מדרש כתובה היא רק לב\"ש?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נג",
        "amud": null
      }
    },
    {
      "id": "כתובות_105",
      "text": "כתוב מצב אחד שאלמנה מפסיקה לקבל מזונות.",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נד",
        "amud": null
      }
    },
    {
      "id": "כתובות_106",
      "text": "מה הנפק\"מ של מש\"כ בביתי ולא בביקתי? (ב' נפק\"מ)",
      "question_type": "תוס'",
      "daf": {
        "daf": "נד",
        "amud": null
      }
    },
    {
      "id": "כתובות_107",
      "text": "לפי מי כתובת בנים דרכין גובה ממשועבדים, למ\"ד ירתון או למ\"ד יסבון?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נה",
        "amud": null
      }
    },
    {
      "id": "כתובות_108",
      "text": "איך החתן יכול להתחייב בסכום שאין לו אותו היום?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נה",
        "amud": null
      }
    },
    {
      "id": "כתובות_109",
      "text": "למה לרבי יהודה אי אפשר להתנות על הכתובה במילים אלא צריך לכתוב?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נו",
        "amud": null
      }
    },
    {
      "id": "כתובות_110",
      "text": "למה הרי זו מקודשת ותנאו בטל, הרי הוא התנה במפורש שהוא לא מקדש אלא בתנאי?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נו",
        "amud": null
      }
    },
    {
      "id": "כתובות_111",
      "text": "האם נותנים לבוגרת י\"ב חודש? (לרב הונא, ומה מסקנת הגמרא)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נז",
        "amud": null
      }
    },
    {
      "id": "כתובות_112",
      "text": "לרב הונא כמה זמן נותנים לנערה שהתקדשה, ולמה היא מקבלת יותר זמן מבוגרת?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נז",
        "amud": null
      }
    },
    {
      "id": "כתובות_113",
      "text": "למה ארוסה לא אוכלת בתרומה למשנה ראשונה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נח",
        "amud": null
      }
    },
    {
      "id": "כתובות_114",
      "text": "למה לאחר שאתגייר לא נחשב לדבר שלא בא לעולם שלא מועיל גם לר\"מ?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נח",
        "amud": null
      }
    },
    {
      "id": "כתובות_115",
      "text": "למה למסקנה אשה לא יכולה לאסור את מעשי ידיה על בעלה מחיים?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "נט",
        "amud": null
      }
    },
    {
      "id": "כתובות_116",
      "text": "אם קונמות מפקיעים מידי שעבוד למה לא כל לווה יפקיע את הממון מהמלוה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "נט",
        "amud": null
      }
    },
    {
      "id": "כתובות_117",
      "text": "עד איזה גיל מותר לינוק?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ס",
        "amud": null
      }
    },
    {
      "id": "כתובות_118",
      "text": "מהו ביעתא בכותחא? (לתוספות)",
      "question_type": "תוס'",
      "daf": {
        "daf": "ס",
        "amud": null
      }
    },
    {
      "id": "כתובות_119",
      "text": "כמה שפחות האשה צריכה להכניס כדי לא לעבוד?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סא",
        "amud": null
      }
    },
    {
      "id": "כתובות_120",
      "text": "מהי הצעת המיטה ששפחה עושה ומהי הצעת המיטה שלעולם היא חיוב של האשה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סא",
        "amud": null
      }
    },
    {
      "id": "כתובות_121",
      "text": "כמה זמן היא עונת תלמידים?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סב",
        "amud": null
      }
    },
    {
      "id": "כתובות_122",
      "text": "איך ר\"ע יצא לכ\"כ הרבה זמן וביטל מצוות עונה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סב",
        "amud": null
      }
    },
    {
      "id": "כתובות_123",
      "text": "מורדת על בעלה פוחתין לה מכתובתה- ממה היא מורדת?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סג",
        "amud": null
      }
    },
    {
      "id": "כתובות_124",
      "text": "האם אדם חייב להשכיר עצמו כדי לשלם את כתובת אשתו?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סג",
        "amud": null
      }
    },
    {
      "id": "כתובות_125",
      "text": "למה במורד לא מחשבים את השבת ובמורדת כן מחשבים את השבת?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סד",
        "amud": null
      }
    },
    {
      "id": "כתובות_126",
      "text": "למה יש נידון של שכר שבת הרי הוא בהבלעה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סד",
        "amud": null
      }
    },
    {
      "id": "כתובות_127",
      "text": "איך מחלקים את דמי הבושת ופגם של אשה נשואה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סה",
        "amud": null
      }
    },
    {
      "id": "כתובות_128",
      "text": "מה הכוונה פגם שבסתר ומה הכוונה בגלוי?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סה",
        "amud": null
      }
    },
    {
      "id": "כתובות_129",
      "text": "למה הבעל מקבל בושת הרי הוא לא התבייש?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סו",
        "amud": null
      }
    },
    {
      "id": "כתובות_130",
      "text": "האם הבעל מקבל תשלום בושת נוסף חוץ מהבושת של האשה או שהוא רק מקבל אחוזים בחלק האשה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סו",
        "amud": null
      }
    },
    {
      "id": "כתובות_131",
      "text": "המשיא את בתו לא יפחות מחמישים זוז- בסלע צורי או סלע מדינה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סז",
        "amud": null
      }
    },
    {
      "id": "כתובות_132",
      "text": "מתי לר\"ש אומרים דברה תורה כלשון בני אדם ומתי לא?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סז",
        "amud": null
      }
    },
    {
      "id": "כתובות_133",
      "text": "לרבי בת שנשאת מקבלת עישור נכסים- מה הדין כשיש עשרה בנות?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סח",
        "amud": null
      }
    },
    {
      "id": "כתובות_134",
      "text": "האם האב חייב בפרנסת בתו כשהיא נשאת?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סח",
        "amud": null
      }
    },
    {
      "id": "כתובות_135",
      "text": "מה הנפק\"מ בזה שפרנסה היא בעלת חוב של האב ולא של היתומים? (כתוב נפק\"מ אחת)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "סט",
        "amud": null
      }
    },
    {
      "id": "כתובות_136",
      "text": "מה הציור שגובים מעמלא דבתי, הרי השכירות שהם קבלו היא מטלטלין?",
      "question_type": "תוס'",
      "daf": {
        "daf": "סט",
        "amud": null
      }
    },
    {
      "id": "כתובות_137",
      "text": "למה המדיר את אשתו לא צריך להוציא אותה אחרי שבועיים מדין מדיר את אשתו מתשמיש המיטה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ע",
        "amud": null
      }
    },
    {
      "id": "כתובות_138",
      "text": "כתוב את תירוץ התוספות לשאלה הנ\"ל.",
      "question_type": "תוס'",
      "daf": {
        "daf": "ע",
        "amud": null
      }
    },
    {
      "id": "כתובות_139",
      "text": "מה הדין במדיר את אשתו בלי זמן מוגבל- האם צריך להוציא מיד?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עא",
        "amud": null
      }
    },
    {
      "id": "כתובות_140",
      "text": "למה בסוגיא האשה לא מפסידה כתובה מדין נודעת ואינה מקיימת?",
      "question_type": "תוס'",
      "daf": {
        "daf": "עא",
        "amud": null
      }
    },
    {
      "id": "כתובות_141",
      "text": "איך נודע לבעל שאשתו האכילה לו דבר שאינו מתוקן?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עב",
        "amud": null
      }
    },
    {
      "id": "כתובות_142",
      "text": "האם אשה שניסתה להאכיל את בעלה דבר שאינו מתוקן ולא הצליחה מפסידה כתובה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "עב",
        "amud": null
      }
    },
    {
      "id": "כתובות_143",
      "text": "למה לרב בקידשה על תנאי וכנסה סתם צריכה גט?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עג",
        "amud": null
      }
    },
    {
      "id": "כתובות_144",
      "text": "איך הבעל עושה את הקידושין במקום שקידשה על תנאי וכנסה סתם?",
      "question_type": "תוס'",
      "daf": {
        "daf": "עג",
        "amud": null
      }
    },
    {
      "id": "כתובות_145",
      "text": "האם יש תנאי בחליצה? למה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עד",
        "amud": null
      }
    },
    {
      "id": "כתובות_146",
      "text": "מה הסברא שתנאי יהיה תלוי בשליחות?",
      "question_type": "תוס'",
      "daf": {
        "daf": "עד",
        "amud": null
      }
    },
    {
      "id": "כתובות_147",
      "text": "מה החילוק בין היו לה מומין בבית חמיה לבין אם הם היו בבית אביה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עה",
        "amud": null
      }
    },
    {
      "id": "כתובות_148",
      "text": "למה לא מצרפים חזקת פנויה שלא אתרע לומר שהמומין היו אחרי הקידושין תחת הבעל?",
      "question_type": "תוס'",
      "daf": {
        "daf": "עה",
        "amud": null
      }
    },
    {
      "id": "כתובות_149",
      "text": "למה מנה לי בידך עדיף על מנה לאבא בידך?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עו",
        "amud": null
      }
    },
    {
      "id": "כתובות_150",
      "text": "מה הצד הנוסף של תוספות לפרש שמנה לי בידך עדיף על מנה לאבא בידך?",
      "question_type": "תוס'",
      "daf": {
        "daf": "עו",
        "amud": null
      }
    },
    {
      "id": "כתובות_151",
      "text": "מה הצד שהאשה יכולה לתבוע שיוציא ויתן כתובה אם היו לו את אותם מומין בשעת הקידושין?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עז",
        "amud": null
      }
    },
    {
      "id": "כתובות_152",
      "text": "במקום שכופים את הבעל להוציא בגלל מומין האם צריך לתת כתובה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "עז",
        "amud": null
      }
    },
    {
      "id": "כתובות_153",
      "text": "מה ההבדל בין המשנה לבין הדין של תקנת אושא?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עח",
        "amud": null
      }
    },
    {
      "id": "כתובות_154",
      "text": "האם כשהאשה ספק נשואה מותר לבעל למכור לכתחילה, והרי היא מוחזקת?",
      "question_type": "תוס'",
      "daf": {
        "daf": "עח",
        "amud": null
      }
    },
    {
      "id": "כתובות_155",
      "text": "מה הדין בהכניסה לו גלימא- האם משתמשים בה או שמוכרים אותה וקונים קרקע?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "עט",
        "amud": null
      }
    },
    {
      "id": "כתובות_156",
      "text": "איזה פירא דפירא לא תקינו ליה רבנן?",
      "question_type": "תוס'",
      "daf": {
        "daf": "עט",
        "amud": null
      }
    },
    {
      "id": "כתובות_157",
      "text": "מה השיעור שהבעל צריך לאכול כדי שיחשב שהוא הוציא ואכל?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "פ",
        "amud": null
      }
    },
    {
      "id": "כתובות_158",
      "text": "מה דין נכסי צאן ברזל של שומרת יבם שמתה לדעת תוספות?",
      "question_type": "תוס'",
      "daf": {
        "daf": "פ",
        "amud": null
      }
    },
    {
      "id": "כתובות_159",
      "text": "למה היבם חייב בקבורת היבמה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "פא",
        "amud": null
      }
    },
    {
      "id": "כתובות_160",
      "text": "מחלוקת ר\"מ ורבנן אם כתובה נגבית ממטלטלין- היא מהבעל עצמו או מיורשיו?",
      "question_type": "תוס'",
      "daf": {
        "daf": "פא",
        "amud": null
      }
    },
    {
      "id": "כתובות_161",
      "text": "מתי מועיל למשוך פרה עמ\"נ לקנות לעוד שלושים יום?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "פב",
        "amud": null
      }
    },
    {
      "id": "כתובות_162",
      "text": "למה בקנין כסף לא אומרים שכלתה קניינו כמו בקנין משיכה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "פב",
        "amud": null
      }
    },
    {
      "id": "כתובות_163",
      "text": "איך מועיל לכתוב לאשתו דין ודברים אין לי בנכסיך הרי אדם לא יכול להסתלק מממון שבבעלותו?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "פג",
        "amud": null
      }
    },
    {
      "id": "כתובות_164",
      "text": "מה הקשר בין הדין של המשנה לבין הדין של רב כהנא שאפשר לומר אי אפשי בתקנת חכמים? (לתוספות)",
      "question_type": "תוס'",
      "daf": {
        "daf": "פג",
        "amud": null
      }
    },
    {
      "id": "כתובות_165",
      "text": "באיזה מקרה ר\"י מודה שאפשר לגבות מטלטלין של מת לאחר מותו?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "פד",
        "amud": null
      }
    },
    {
      "id": "כתובות_166",
      "text": "האם שליח יכול לתופס לבעל חוב במקום שחב לאחרים?",
      "question_type": "תוס'",
      "daf": {
        "daf": "פד",
        "amud": null
      }
    },
    {
      "id": "כתובות_167",
      "text": "מה הדיין יכול לעשות לשטר ע\"י שקים ליה בגויה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "פה",
        "amud": null
      }
    },
    {
      "id": "כתובות_168",
      "text": "לתוספות מה הכוונה מרענא שטר אפומיה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "פה",
        "amud": null
      }
    },
    {
      "id": "כתובות_169",
      "text": "אם פריעת בעל חוב מצוה איך בי\"ד כופה את מי שלא רוצה לשלם?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "פו",
        "amud": null
      }
    },
    {
      "id": "כתובות_170",
      "text": "מתי בי\"ד כופה את היתומים לשלם את החוב של אביהם?",
      "question_type": "תוס'",
      "daf": {
        "daf": "פו",
        "amud": null
      }
    },
    {
      "id": "כתובות_171",
      "text": "למה אלמנה צריכה להשבע כשהיא גובה כתובה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "פז",
        "amud": null
      }
    },
    {
      "id": "כתובות_172",
      "text": "באיזה מקרה צריך לחדש שמוכרים לכתובה בלי להכריז?",
      "question_type": "תוס'",
      "daf": {
        "daf": "פז",
        "amud": null
      }
    },
    {
      "id": "כתובות_173",
      "text": "מה הנפק\"מ בין שבועה דאוריתא לדרבנן?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "פח",
        "amud": null
      }
    },
    {
      "id": "כתובות_174",
      "text": "כתוב נפק\"מ נוספת",
      "question_type": "תוס'",
      "daf": {
        "daf": "פח",
        "amud": null
      }
    },
    {
      "id": "כתובות_175",
      "text": "איך גובים כתובה עם הגט הרי אולי האשה תגבה שוב עם הכתובה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "פט",
        "amud": null
      }
    },
    {
      "id": "כתובות_176",
      "text": "האם לדינא כותבים שובר?",
      "question_type": "תוס'",
      "daf": {
        "daf": "פט",
        "amud": null
      }
    },
    {
      "id": "כתובות_177",
      "text": "האם בעל חוב מוקדם קודם לבעל חוב מאוחר? ומה הדין בדיעבד כשהמאוחר גבה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "צ",
        "amud": null
      }
    },
    {
      "id": "כתובות_178",
      "text": "מה הצד שבעל חוב מאוחר שקדם וגבה לא מוציאים ובמה הוא עדיף מלקוח?",
      "question_type": "תוס'",
      "daf": {
        "daf": "צ",
        "amud": null
      }
    },
    {
      "id": "כתובות_179",
      "text": "לוקח שפרע סכום גבוה בשביל להשאיר את הקרקע אצלו- גובה מהלוה את שווי הקרקע או את השוויה שהוא פרע מההלואה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "צא",
        "amud": null
      }
    },
    {
      "id": "כתובות_180",
      "text": "האם הלוקח יכול להכריח את המלוה לקבל מעות במקום הקרקע?",
      "question_type": "תוס'",
      "daf": {
        "daf": "צא",
        "amud": null
      }
    },
    {
      "id": "כתובות_181",
      "text": "באיזה מקרה המוכר נחשב בעל דין לגבי טריפה של הקרקע מלקוחות?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "צב",
        "amud": null
      }
    },
    {
      "id": "כתובות_182",
      "text": "האם טענינן מזויף או שהנתבע צריך לטעון בעצמו?",
      "question_type": "תוס'",
      "daf": {
        "daf": "צב",
        "amud": null
      }
    },
    {
      "id": "כתובות_183",
      "text": "מי שהיה נשוי ג' נשים ויש להם שיעור כתובה שונה, לרבי נתן חולקות בשווה- מה הכוונה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "צג",
        "amud": null
      }
    },
    {
      "id": "כתובות_184",
      "text": "לדעת ר\"ח- באיזה מקרה חולקים בשוה? ומה הדין בד\"כ?",
      "question_type": "תוס'",
      "daf": {
        "daf": "צג",
        "amud": null
      }
    },
    {
      "id": "כתובות_185",
      "text": "מה הדין ב' שטרות היוצאים ביום אחד?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "צד",
        "amud": null
      }
    },
    {
      "id": "כתובות_186",
      "text": "האם למ\"ד עדי חתימה כרתי יכול להיות שודא?",
      "question_type": "תוס'",
      "daf": {
        "daf": "צד",
        "amud": null
      }
    },
    {
      "id": "כתובות_187",
      "text": "אשתדוף בני חרי גובים ממשעבדי?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "צה",
        "amud": null
      }
    },
    {
      "id": "כתובות_188",
      "text": "למה במקום שהמלוה מחל את השעבוד של הלוקח האחרון הוא לא גובה מלוקח ראשון?",
      "question_type": "תוס'",
      "daf": {
        "daf": "צה",
        "amud": null
      }
    },
    {
      "id": "כתובות_189",
      "text": "האם מועילה תפיסת מטלטלין למזונות? ומה הדין לכתובה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "צו",
        "amud": null
      }
    },
    {
      "id": "כתובות_190",
      "text": "האם התפיסה של הסוגיא היא מחיים או לאחר מיתה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "צו",
        "amud": null
      }
    },
    {
      "id": "כתובות_191",
      "text": "מי שמכר קרקע ובסוף לא היה צריך את הכסף- האם הוא יכול לבטל את המקח?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "צז",
        "amud": null
      }
    },
    {
      "id": "כתובות_192",
      "text": "באיזה מצב יש דיון אם אפשר לבטל את המקח?",
      "question_type": "תוס'",
      "daf": {
        "daf": "צז",
        "amud": null
      }
    },
    {
      "id": "כתובות_193",
      "text": "למה אלמנה שמכרה בלי בית דין לא עשתה כלום?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "צח",
        "amud": null
      }
    },
    {
      "id": "כתובות_194",
      "text": "לשיטת תוספות מה החסרון במכירה של האלמנה שמכרה לעצמה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "צח",
        "amud": null
      }
    },
    {
      "id": "כתובות_195",
      "text": "מהם ב' ספקות הגמרא בשליח שנשלח למכור קרקע ושינה מדעת בעל הבית?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "צט",
        "amud": null
      }
    },
    {
      "id": "כתובות_196",
      "text": "בגמרא יש מחלוקת מה הדין במקום שאמר למכור לאחד ומכר לשנים- למה אין טענת אפושי שטרי? (כתוב תשובה אחת)",
      "question_type": "תוס'",
      "daf": {
        "daf": "צט",
        "amud": null
      }
    },
    {
      "id": "כתובות_197",
      "text": "מה הדין שליח שטעה- האם המקח קיים? ומה הדין בשליח שתרם?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ק",
        "amud": null
      }
    },
    {
      "id": "כתובות_198",
      "text": "באיזה שליח מדובר בסוגיא?",
      "question_type": "תוס'",
      "daf": {
        "daf": "ק",
        "amud": null
      }
    },
    {
      "id": "כתובות_199",
      "text": "האם ממאנת מקבלת נכסי צאן ברזל?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קא",
        "amud": null
      }
    },
    {
      "id": "כתובות_200",
      "text": "באיזה בלאי הבעל חייב לממאנת?",
      "question_type": "תוס'",
      "daf": {
        "daf": "קא",
        "amud": null
      }
    },
    {
      "id": "כתובות_201",
      "text": "חייב אני לך מנה- מה המקרה שבו נחלקו רבי יוחנן ור\"ל למסקנה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קב",
        "amud": null
      }
    },
    {
      "id": "כתובות_202",
      "text": "מה הציור של חייב אני לך מנה לדעת התוספות?",
      "question_type": "תוס'",
      "daf": {
        "daf": "קב",
        "amud": null
      }
    },
    {
      "id": "כתובות_203",
      "text": "האם היתומים יכולים למכור אלמנה? ומה הדין בדיעבד אם מכרו?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קג",
        "amud": null
      }
    },
    {
      "id": "כתובות_204",
      "text": "ברכת הבית ברובה- מה הכוונה (רש\"י ותוספות)",
      "question_type": "תוס'",
      "daf": {
        "daf": "קג",
        "amud": null
      }
    },
    {
      "id": "כתובות_205",
      "text": "למה אלמנה מפסידה כתובה אם היא לא תבעה אחרי כ\"ה שנים?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קד",
        "amud": null
      }
    },
    {
      "id": "כתובות_206",
      "text": "למה גם מרתא בת בייתוס מפסידה כתובה באותו שיעור זמן כמו אשה רגילה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "קד",
        "amud": null
      }
    },
    {
      "id": "כתובות_207",
      "text": "איזה שכר מותר לדיינים לקבל?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קה",
        "amud": null
      }
    },
    {
      "id": "כתובות_208",
      "text": "איזה שכר נוסף מותר לדיינים לקבל, שאותו קבלו גוזרי גזירות שבירושלים?",
      "question_type": "תוס'",
      "daf": {
        "daf": "קה",
        "amud": null
      }
    },
    {
      "id": "כתובות_209",
      "text": "למה לא פוסקים מזונות לאשת איש? (ב' טעמים)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קו",
        "amud": null
      }
    },
    {
      "id": "כתובות_210",
      "text": "איך שמעו בו שמת?",
      "question_type": "תוס'",
      "daf": {
        "daf": "קו",
        "amud": null
      }
    },
    {
      "id": "כתובות_211",
      "text": "למה אין פוסקים מזונות לאשת איש?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קז",
        "amud": null
      }
    },
    {
      "id": "כתובות_212",
      "text": "שמעו בו שמת- האם מדובר בקול, עד אחד או ב' עדים?",
      "question_type": "תוס'",
      "daf": {
        "daf": "קז",
        "amud": null
      }
    },
    {
      "id": "כתובות_213",
      "text": "באיזה ציור מותר למודר הנאה מחבירו לפרוע את חובו?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קח",
        "amud": null
      }
    },
    {
      "id": "כתובות_214",
      "text": "מה ההבדל בין פורע חוב שמותר לבין מחזיר אבידה שמקבל שכר?",
      "question_type": "תוס'",
      "daf": {
        "daf": "קח",
        "amud": null
      }
    },
    {
      "id": "כתובות_215",
      "text": "באיזה מקרה נחלקו רבנן ואדמון אם המקיף את חבירו מארבע רוחותיו צריך לתת לו דרך?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קט",
        "amud": null
      }
    },
    {
      "id": "כתובות_216",
      "text": "למה אחד שקנה מאחד לא יכול לומר לניקף שהוא ימכור לארבע אנשים?",
      "question_type": "תוס'",
      "daf": {
        "daf": "קט",
        "amud": null
      }
    },
    {
      "id": "כתובות_217",
      "text": "שנים שהוציאו שטר חוב זה על זה באיזה מקרה יש נפק\"מ מי גובה קודם?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קי",
        "amud": null
      }
    },
    {
      "id": "כתובות_218",
      "text": "האם יש מצוה לעלות לאר\"י בזמן הזה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "קי",
        "amud": null
      }
    },
    {
      "id": "כתובות_219",
      "text": "מהם שלושת השבועות?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קיא",
        "amud": null
      }
    },
    {
      "id": "כתובות_220",
      "text": "האם לעמי הארצות יש חלק לעולם הבא? למה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "קיא",
        "amud": null
      }
    },
    {
      "id": "כתובות_221",
      "text": "חברון ומצרים- מי עדיפה?",
      "question_type": "רש\"י",
      "daf": {
        "daf": "קיב",
        "amud": null
      }
    },
    {
      "id": "כתובות_222",
      "text": "האם עכו היא ארץ ישראל?",
      "question_type": "תוס'",
      "daf": {
        "daf": "קיב",
        "amud": null
      }
    }
