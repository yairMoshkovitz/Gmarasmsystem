      "daf": {
        "daf": "ב",
        "amud": null
      }
    },
    {
      "id": "כתובות_2",
      "text": "מה הצד שהבעל חייב מזונות כשהאשה חולה ולא אומרים שזה אשמתה?",
      "question_type": "תוס'",
      "daf": {
        "daf": "ב",
        "amud": null
      }
    },
    {
      "id": "כתובות_3",
      "text": "למה למסקנה יש אונס בגיטין?",
