      "daf": {
        "daf": "ה",
        "amud": null
      }
    },
    {
      "id": "כתובות_9",
      "text": "כתוב ב' סיבות למה לאסור לבעול בתחילה בשבת (לפי שיטות שונות)",
      "question_type": "רש\"י",
      "daf": {
        "daf": "ו",
        "amud": null
      }
    },
    {
      "id": "כתובות_10",
      "text": "מה הדין בפס\"ר דלא ניחא ליה לפי תוספות ולפי הערוך?",
